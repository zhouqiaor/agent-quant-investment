    "@nestjs/platform-express": "^10.4.15",
    "@supabase/supabase-js": "2.95.3",
    "better-sqlite3": "^13.0.3",
    "coze-coding-dev-sdk": "^0.7.24",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "5.2.1",
    "pg": "^8.16.3",
    "rxjs": "^7.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
